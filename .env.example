# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Telegram-бот напоминаний трекера (необязательно) ─────────────
# Токен от @BotFather. Без него сайт работает как раньше (напоминания только на почту).
# Вебхук бот регистрирует сам при старте сервера по адресу SITE_URL/api/webhooks/telegram.
# Один токен — один сервер: на dev и prod нужны разные боты.
TELEGRAM_BOT_TOKEN=
# Только если с сервера не открывается api.telegram.org — адрес своего прокси/зеркала.
TELEGRAM_API_BASE=
