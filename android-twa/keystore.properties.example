# Скопируйте этот файл в keystore.properties и заполните реальными значениями.
# keystore.properties в git НЕ попадёт (см. .gitignore) — это правильно.
#
# storeFile — путь к вашему файлу ключа (создаётся командой keytool, см. README).
storeFile=ai-nastoika.keystore
storePassword=ВАШ_ПАРОЛЬ_ХРАНИЛИЩА
keyAlias=ai-nastoika
keyPassword=ВАШ_ПАРОЛЬ_КЛЮЧА
